# Copy thành .env rồi điền key thật.  KHÔNG commit .env.
#   PowerShell:  Copy-Item .env.example .env

# --- OpenAI ---
OPENAI_API_KEY=sk-thay-bang-key-that

# Phân tầng model (ARCHITECHTURE.md §12):
#   FAST = tóm tắt từng trang (nhiều lời gọi, đầu vào nhỏ)
#   MAIN = reduce cuối + sinh quiz (nơi sai thì đau)
# Xem account mình có model nào:  python check_env.py --models
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_MAIN=gpt-4o

# --- Ngưỡng xử lý tài liệu ---
PAGE_DPI=110                # render trang ra PNG
MIN_CHARS_PER_PAGE=120      # dưới ngưỡng => trang thiên về hình => abstain (lớp ①)
MIN_WORDS_PER_SELECTION=40  # đoạn bôi đen ngắn hơn => hỏi lại (lớp ②)

# --- Chặn chi phí ---
MAX_DIRECT_TOKENS=6000      # vượt => chuyển map-reduce
MAX_JOB_CALLS=60            # trần số lời gọi cho một job
REQUEST_TIMEOUT_S=60

# --- Log ---
TRACE_INCLUDE_TEXT=0        # 1 = ghi nguyên văn scope vào eval/traces/ (rà trước khi commit)
