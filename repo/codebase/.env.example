# Copy thành .env rồi điền key thật.  KHÔNG commit .env.
#   PowerShell:  Copy-Item .env.example .env

# --- Provider ---
# Tầng providers/ là chỗ duy nhất biết đến nhà cung cấp model. Thêm provider mới
# = thêm một file trong providers/ và đổi biến này; prompt và schema giữ nguyên.
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-thay-bang-key-that

# Phân tầng model:
#   FAST = tóm tắt từng trang (nhiều lời gọi, đầu vào nhỏ, sai thì rẻ)
#   MAIN = gộp cuối map-reduce + sinh quiz + chat (nơi sai thì đau)
# Xem account mình có model nào:  python check_env.py --models
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_MAIN=gpt-4o

# --- Ngưỡng xử lý tài liệu ---
PAGE_DPI=110                # render trang ra PNG
MIN_CHARS_PER_PAGE=120      # dưới ngưỡng => trang thiên về hình => abstain, không đoán

# --- Chặn chi phí ---
MAX_DIRECT_TOKENS=6000      # vượt => chuyển map-reduce thay vì cắt bớt văn bản
MAX_JOB_CALLS=60            # trần lời gọi cho một job; vượt thì hỏi trước, không âm thầm đốt
REQUEST_TIMEOUT_S=60

# --- Chat hỏi đáp (agent_core/retrieve.py) ---
CHAT_TOP_K=6                # số đoạn đưa cho model mỗi câu hỏi
CHAT_MIN_SCORE=0.08         # điểm đã chuẩn hoá theo đoạn tốt nhất; cao hơn => chặt hơn,
                            # dễ trả "không tìm thấy" hơn là trả lời từ đoạn yếu

# --- Log ---
TRACE_INCLUDE_TEXT=0        # 1 = ghi nguyên văn scope vào eval/traces/ (rà trước khi commit)
